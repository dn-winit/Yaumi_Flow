# Yaumi Flow -- unified env config. Copy to .env and fill in values.
# Each backend service reads its own block (env_prefix in brackets).

# === Service Ports ===
DI_PORT=8005      # data_import
DF_PORT=8002      # demand_forecasting_pipeline
RO_PORT=8001      # recommended_order
SS_PORT=8004      # sales_supervision
LLM_PORT=8003     # llm_analytics
WEBAPP_PORT=3000

# === data_import [DI_DB_*] -- reads YaumiLive, optionally writes YaumiAIML ===
DI_DB_HOST=your-db-server
DI_DB_PORT=1433
DI_DB_DATABASE=YaumiLive
DI_DB_USERNAME=your_username
DI_DB_PASSWORD=your_password
DI_DB_DRIVER={ODBC Driver 17 for SQL Server}
DI_DB_CONNECTION_TIMEOUT=120
# Leader-election lock; only one worker per host fires the daily import cron.
# Default <data-root>/imports/scheduler.lock. Override only for non-standard deploys.
DI_SCHEDULER_LOCK_PATH=
# Tighter live cut-throughs so a slow YaumiLive cannot stall a UI click.
DI_DB_LIVE_CONNECTION_TIMEOUT=10
DI_DB_LIVE_QUERY_TIMEOUT=15

# AIML mirror -- read-back validation only.
DI_AIML_DB_HOST=your-db-server
DI_AIML_DB_PORT=1433
DI_AIML_DB_DATABASE=YaumiAIML
DI_AIML_DB_USERNAME=your_username
DI_AIML_DB_PASSWORD=your_password

# === demand_forecasting_pipeline [DF_DB_*] -- pushes forecast to YaumiAIML ===
DF_DB_HOST=your-db-server
DF_DB_PORT=1433
DF_DB_DATABASE=YaumiAIML
DF_DB_USERNAME=your_username
DF_DB_PASSWORD=your_password
DF_DB_CONNECTION_TIMEOUT=120
DF_DB_QUERY_TIMEOUT=300
DF_DB_RETRY_ATTEMPTS=3
DF_DB_RETRY_DELAY=2
DF_DEMAND_TABLE=[YaumiAIML].[dbo].[yf_demand_forecast]
DF_DB_EXECUTEMANY_CHUNK_SIZE=1000
# After inference push, ping data_import to refresh demand_forecast.csv. Empty disables.
DF_DATA_IMPORT_URL=http://localhost:8005
# After reconciliation cascade, ping sales_supervision to drop cached sessions
# so the next reconcile tick picks up freshly-generated recommendations. Empty disables.
DF_SALES_SUPERVISION_URL=http://localhost:8004

# === Reconciliation engine -- V2 layers (env-overridable) ===
# L1 bias correction; L1b pair-maturity bias shrinkage; L4 class-aware
# quantile loading (newsvendor); L2 leftover-aware fresh issuance.
# Per-class quantile trades lost-sales risk vs overnight stock.
DF_BIAS_LOOKBACK_DAYS=30
DF_BIAS_CAP_PCT=0.50
DF_CARRY_FLOOR_PCT=0.50
DF_PAIR_MATURITY_THRESHOLD_DAYS=14
DF_MATURITY_SHRINKAGE_ENABLED=true
DF_LOADING_QUANTILE_SMOOTH=0.50
DF_LOADING_QUANTILE_INTERMITTENT=0.40
DF_LOADING_QUANTILE_ERRATIC=0.35
DF_LOADING_QUANTILE_LUMPY=0.30
DF_LOADING_QUANTILE_DEFAULT=0.50
DF_QUANTILE_LOADING_ENABLED=true
# Decision-band thresholds for the "vs typical" allocation label.
DF_TYPICAL_ALLOC_BAND_LOW=0.70
DF_TYPICAL_ALLOC_BAND_HIGH=1.30

# === recommended_order [RO_DB_*] -- pushes recommendations to YaumiAIML ===
RO_DB_HOST=your-db-server
RO_DB_PORT=1433
RO_DB_USERNAME=your_username
RO_DB_PASSWORD=your_password
RO_DB_CONNECTION_TIMEOUT=120
RO_DB_QUERY_TIMEOUT=300
RO_DB_EXECUTEMANY_CHUNK_SIZE=1000
RO_RECOMMENDATION_TABLE=[YaumiAIML].[dbo].[yf_recommended_orders]
# Parallel route generation workers; 4 covers the usual 12-route fleet.
RO_GENERATION_CONCURRENCY=4
# Leader-election lock; only one worker per host fires the daily generation cron.
# Default <data-root>/recommendations/scheduler.lock. Override only for non-standard deploys.
RO_SCHEDULER_LOCK_PATH=

# === sales_supervision [SS_DB_*] -- saves sessions to YaumiAIML ===
SS_DB_HOST=your-db-server
SS_DB_PORT=1433
SS_DB_DATABASE=YaumiAIML
SS_DB_USERNAME=your_username
SS_DB_PASSWORD=your_password
SS_DB_CONNECTION_TIMEOUT=120
# Tight per-query budget -- Save Session is interactive.
SS_DB_QUERY_TIMEOUT=60
SS_DB_EXECUTEMANY_CHUNK_SIZE=1000
SS_ROUTE_SUMMARY_TABLE=[YaumiAIML].[dbo].[yf_supervision_routes]
SS_CUSTOMER_SUMMARY_TABLE=[YaumiAIML].[dbo].[yf_supervision_customers]
SS_ITEM_DETAILS_TABLE=[YaumiAIML].[dbo].[yf_supervision_items]
# Upstream HTTP base for live actuals (mirrors DI_PORT above).
SS_DATA_IMPORT_URL=http://localhost:8005
SS_DATA_IMPORT_TIMEOUT=15
# In-memory session registry -- defaults cover an 8-hour shift.
SS_SESSION_REGISTRY_MAX=256
SS_SESSION_TTL_SECONDS=28800
# Leader-election lock path; only one worker per host fires the reconciler.
# Default <data-root>/supervision/scheduler.lock. Override only for non-standard deploys.
SS_SCHEDULER_LOCK_PATH=

# === Auto-visit reconciler -- background mirror of YaumiLive invoices ===
SS_AUTO_VISIT_ENABLED=true
SS_AUTO_VISIT_POLL_SECONDS=300
# Empty -> falls back to demand_forecasting.live_route_codes.
SS_AUTO_VISIT_ROUTE_CODES=
# Trigger LLM analyses inside the reconciler; needs SS_LLM_ANALYTICS_URL.
SS_AUTO_VISIT_LLM_ENABLED=true

# Recommended-order client (used by the reconciler to scope sessions).
SS_RECOMMENDED_ORDER_URL=http://localhost:8001
SS_RECOMMENDED_ORDER_TIMEOUT=30
SS_RECOMMENDATION_CACHE_SECONDS=300
SS_RECOMMENDATION_FETCH_LIMIT=10000

# LLM analytics client; empty -> reconciler skips LLM calls.
SS_LLM_ANALYTICS_URL=http://localhost:8003
SS_LLM_ANALYTICS_TIMEOUT=120

# === llm_analytics -- AI explanations / briefings ===
LLM_PROVIDER=groq
LLM_API_KEY=your_api_key
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.0
# Briefings rarely exceed ~1500 tokens; bump to 4096 if your prompts need more.
LLM_MAX_TOKENS=1500
LLM_TIMEOUT=45
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_HOURS=24
# Stay one notch below the Groq server-side limit (free-tier 30 RPM on llama-3.1-8b).
# 429s trigger fallback responses that the reconciler refuses to save.
LLM_RATE_LIMIT_MAX_REQUESTS=25
LLM_RATE_LIMIT_WINDOW_SECONDS=60
# Hard caps on prompt size; the formatter truncates and adds a "... N more"
# footer so a pathological route can't blow the token budget.
LLM_MAX_ITEMS_PER_CUSTOMER=12
LLM_MAX_CUSTOMERS_PER_ROUTE=50

# === Frontend -- Vite reads these at build time ===
VITE_DATA_IMPORT_URL=http://localhost:8005
VITE_FORECAST_URL=http://localhost:8002
VITE_RECOMMENDED_ORDER_URL=http://localhost:8001
VITE_SUPERVISION_URL=http://localhost:8004
VITE_ANALYTICS_URL=http://localhost:8003

# === Cross-service shared (YF_* prefix; read via common/) ===
# CORS allow-list, parsed CSV or JSON-array. Empty = wide-open dev (UNSAFE in prod).
YF_ALLOW_ORIGINS=http://localhost:3000
# Fleet route registry; CSV string. Empty = no override (common/route_registry default).
YF_ROUTE_CODES=
# Project-data root override (default <repo>/data). Use only for non-standard deploys.
YF_DATA_ROOT=
# "production" vs "dev"/"staging" -- gates ``common.runtime.require_env`` hard-fails.
YF_ENV=dev
# Leader-election opt-out: set to 1/true/yes to treat the worker as leader
# WITHOUT acquiring a file lock. ONLY safe under workers=1 (tests, single-shot
# scripts). Multi-worker deployments MUST leave this unset so common/leader_election
# can enforce the single-fire-per-host invariant.
YF_LEADER_LOCK_DISABLE=

# === demand_forecasting_pipeline extras ===
# Drift-alert webhook (POST JSON). Empty disables drift webhooks; cron logs only.
YF_DRIFT_WEBHOOK_URL=
# Fail-fast YAML validation on startup ("true" = abort on schema mismatch).
DF_VALIDATE_CONFIG=true
# Log output format: "json" (structured) or "text" (dev-friendly).
DF_LOG_FORMAT=json
# Override logs dir (default <repo>/data/forecast/logs).
DF_LOGS_DIR=
# Leader-election lock; only one worker per host runs retrain+recon schedulers.
# Default <data-root>/forecast/scheduler.lock. Override only for non-standard deploys.
DF_SCHEDULER_LOCK_PATH=

# === Deployment metadata (set by CI; consumed by /health, training audit) ===
# Override either to surface the running commit hash in /health.
GIT_COMMIT=
CI_COMMIT_SHA=
