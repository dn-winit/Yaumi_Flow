# ============================================================
# Yaumi Flow -- Unified Environment Configuration
# Copy to .env and fill in your values. Every backend service
# reads its own block (env_prefix shown in brackets).
# ============================================================

# ------------------------------------------------------------
# Service ports
# ------------------------------------------------------------
DI_PORT=8005      # data_import
DF_PORT=8002      # demand_forecasting_pipeline
RO_PORT=8001      # recommended_order
SS_PORT=8004      # sales_supervision
LLM_PORT=8003     # llm_analytics
WEBAPP_PORT=3000

# ------------------------------------------------------------
# data_import [DI_DB_*]  --  reads YaumiLive (sales view)
#                            optionally writes to YaumiAIML
# ------------------------------------------------------------
DI_DB_HOST=your-db-server
DI_DB_PORT=1433
DI_DB_DATABASE=YaumiLive
DI_DB_USERNAME=your_username
DI_DB_PASSWORD=your_password
DI_DB_DRIVER={ODBC Driver 17 for SQL Server}
# Connect handshake budget (seconds). Bulk imports use this directly.
DI_DB_CONNECTION_TIMEOUT=120
# Live cut-throughs served to the supervisor UI use these tighter
# bounds so a slow YaumiLive cannot stall an interactive click.
DI_DB_LIVE_CONNECTION_TIMEOUT=10
DI_DB_LIVE_QUERY_TIMEOUT=15

# AIML mirror -- only used by data_import for read-back validation.
DI_AIML_DB_HOST=your-db-server
DI_AIML_DB_PORT=1433
DI_AIML_DB_DATABASE=YaumiAIML
DI_AIML_DB_USERNAME=your_username
DI_AIML_DB_PASSWORD=your_password

# ------------------------------------------------------------
# demand_forecasting_pipeline [DF_DB_*]  --  pushes forecast to YaumiAIML
# ------------------------------------------------------------
DF_DB_HOST=your-db-server
DF_DB_PORT=1433
DF_DB_DATABASE=YaumiAIML
DF_DB_USERNAME=your_username
DF_DB_PASSWORD=your_password
DF_DB_CONNECTION_TIMEOUT=120
# Cursor timeout bounds bulk INSERT rounds (1000-row chunks).
DF_DB_QUERY_TIMEOUT=300
DF_DB_RETRY_ATTEMPTS=3
DF_DB_RETRY_DELAY=2
DF_DEMAND_TABLE=[YaumiAIML].[dbo].[yf_demand_forecast]
DF_DB_EXECUTEMANY_CHUNK_SIZE=1000
# Cascade: after a successful inference push, ping data_import to
# refresh data/demand_forecast.csv so recommended_order sees the
# new numbers immediately. Leave empty to disable.
DF_DATA_IMPORT_URL=http://localhost:8005

# ------------------------------------------------------------
# Reconciliation engine -- V2 layers (all defaults env-overridable)
#
#   L1   bias correction      P_corrected = Predicted / (1 + bias)
#   L1b  pair-maturity bias shrinkage
#         effective_bias = bias_pct * min(1, n_active / threshold)
#   L4   class-aware quantile loading (newsvendor)
#         target = interpolate(q_low, P_corrected, q_high) at class_quantile
#   L2   leftover-aware fresh issuance
#         fresh = max(0, target - leftover)
#
# Per-class quantile = the deliberate trade between lost-sales risk
# and overnight stock. Lumpy items load at q30 (under-issue);
# smooth items load at q50 (= P_corrected, the V5_b mean).
# ------------------------------------------------------------
DF_BIAS_LOOKBACK_DAYS=30
DF_BIAS_CAP_PCT=0.50
DF_CARRY_FLOOR_PCT=0.50
DF_PAIR_MATURITY_THRESHOLD_DAYS=14
DF_MATURITY_SHRINKAGE_ENABLED=true
DF_LOADING_QUANTILE_SMOOTH=0.50
DF_LOADING_QUANTILE_INTERMITTENT=0.40
DF_LOADING_QUANTILE_ERRATIC=0.35
DF_LOADING_QUANTILE_LUMPY=0.30
DF_LOADING_QUANTILE_DEFAULT=0.50
DF_QUANTILE_LOADING_ENABLED=true
# Decision-band thresholds for the "vs typical" allocation label.
DF_TYPICAL_ALLOC_BAND_LOW=0.70
DF_TYPICAL_ALLOC_BAND_HIGH=1.30

# ------------------------------------------------------------
# recommended_order [RO_DB_*]  --  pushes recommendations to YaumiAIML
# ------------------------------------------------------------
RO_DB_HOST=your-db-server
RO_DB_PORT=1433
RO_DB_USERNAME=your_username
RO_DB_PASSWORD=your_password
RO_DB_CONNECTION_TIMEOUT=120
RO_DB_QUERY_TIMEOUT=300
RO_DB_EXECUTEMANY_CHUNK_SIZE=1000
RO_RECOMMENDATION_TABLE=[YaumiAIML].[dbo].[yf_recommended_orders]
# Concurrency for parallel route generation (one ThreadPool worker per route).
# Tune by route fleet size; default 4 covers the usual 12-route deployment.
RO_GENERATION_CONCURRENCY=4

# ------------------------------------------------------------
# sales_supervision [SS_DB_*]  --  saves sessions to YaumiAIML
# ------------------------------------------------------------
SS_DB_HOST=your-db-server
SS_DB_PORT=1433
SS_DB_DATABASE=YaumiAIML
SS_DB_USERNAME=your_username
SS_DB_PASSWORD=your_password
SS_DB_CONNECTION_TIMEOUT=120
# Tight per-query budget -- Save Session is interactive; the
# supervisor cannot wait minutes for a single click.
SS_DB_QUERY_TIMEOUT=60
SS_DB_EXECUTEMANY_CHUNK_SIZE=1000
SS_ROUTE_SUMMARY_TABLE=[YaumiAIML].[dbo].[yf_supervision_routes]
SS_CUSTOMER_SUMMARY_TABLE=[YaumiAIML].[dbo].[yf_supervision_customers]
SS_ITEM_DETAILS_TABLE=[YaumiAIML].[dbo].[yf_supervision_items]
# Upstream HTTP base for live actuals (data_import). Mirrors the
# DI_PORT above so a single change keeps both sides in sync.
SS_DATA_IMPORT_URL=http://localhost:8005
SS_DATA_IMPORT_TIMEOUT=15
# In-memory session registry knobs. Caps both concurrent in-memory
# supervision sessions and how long an idle session is held before
# eviction. Defaults cover an 8-hour shift; extend for longer ones.
SS_SESSION_REGISTRY_MAX=256
SS_SESSION_TTL_SECONDS=28800

# ------------------------------------------------------------
# Auto-visit reconciler -- background job that mirrors live
# YaumiLive invoices into yf_supervision_* tables every N seconds,
# without depending on a browser tab being open.
# ------------------------------------------------------------
SS_AUTO_VISIT_ENABLED=true
SS_AUTO_VISIT_POLL_SECONDS=300
# Empty -> falls back to demand_forecasting.live_route_codes.
SS_AUTO_VISIT_ROUTE_CODES=
# Trigger LLM analyses (customer + route) as part of the reconciler.
# Requires SS_LLM_ANALYTICS_URL to be set; otherwise the LLM step is
# silently skipped.
SS_AUTO_VISIT_LLM_ENABLED=true

# Recommended-order client (used by the reconciler to scope sessions).
SS_RECOMMENDED_ORDER_URL=http://localhost:8001
SS_RECOMMENDED_ORDER_TIMEOUT=30
SS_RECOMMENDATION_CACHE_SECONDS=300
SS_RECOMMENDATION_FETCH_LIMIT=10000

# LLM analytics client (best-effort during the reconciler).
# Empty -> auto-visit reconciler skips all LLM calls.
SS_LLM_ANALYTICS_URL=http://localhost:8003
SS_LLM_ANALYTICS_TIMEOUT=120

# ------------------------------------------------------------
# llm_analytics  --  AI explanations / briefings
# ------------------------------------------------------------
LLM_PROVIDER=groq
LLM_API_KEY=your_api_key
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.0
# Briefing / customer-analysis / route-summary JSONs rarely exceed ~1500
# tokens; lower cap = faster responses, lower cost, less mid-response
# truncation. Bump to 4096 if your prompts return longer payloads.
LLM_MAX_TOKENS=1500
LLM_TIMEOUT=45
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_HOURS=24
# Self-throttle one notch below the Groq account's server-side limit
# (typical free-tier: 30 RPM on llama-3.1-8b). Hitting the server cap
# triggers 429 + fallback responses, which the auto-reconciler refuses
# to save -- leaving NULLs in the LLM columns. 25/60 keeps headroom.
# Paid tiers can safely raise to 600+/60.
LLM_RATE_LIMIT_MAX_REQUESTS=25
LLM_RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------
# Frontend  --  Vite reads these at build time
# ------------------------------------------------------------
VITE_DATA_IMPORT_URL=http://localhost:8005
VITE_FORECAST_URL=http://localhost:8002
VITE_RECOMMENDED_ORDER_URL=http://localhost:8001
VITE_SUPERVISION_URL=http://localhost:8004
VITE_ANALYTICS_URL=http://localhost:8003
